{
    "info": {
        "name": "SIGDEI API",
        "description": "Coleção do Postman com todas as requisições da plataforma SIGDEI",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000/api/v1",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Autenticação",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if(jsonData.access) {",
                                    "    pm.collectionVariables.set(\"jwt_token\", jsonData.access);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"matricula\": \"admin\",\n    \"senha\": \"admin123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/users/login/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "users",
                                "login",
                                ""
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Usuários",
            "item": [
